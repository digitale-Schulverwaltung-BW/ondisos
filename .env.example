# ============================================================================
# Docker Compose Environment Variables
# ============================================================================
# This file is the single source of truth for credentials shared between
# the backend and MySQL container. Copy to .env and customize.
#
# Usage: Docker Compose automatically loads .env from the project root.
# ============================================================================

# Database Credentials (used by both backend PHP and MySQL container)
DB_HOST=mysql  # Docker service name (do NOT change)
DB_PORT=3306
DB_NAME=anmeldung
DB_USER=anmeldung
DB_PASS=secret123  # CHANGE IN PRODUCTION!

# MySQL Root Password (for admin access)
MYSQL_ROOT_PASSWORD=rootpass123  # CHANGE IN PRODUCTION!

# Password discussion:
# in the recommended Docker deployment for production systems, the MySQL container
# is unreachable. Therefore, password security is not mission-critical, but 
# recommended.

# Backend Secrets
PDF_TOKEN_SECRET=dev-secret-key-replace-in-production-min-32-chars  # Min 32 chars!
# API secret of the default tenant (id=1). migrate.php adopts it; the frontend signs its
# backend requests with it (TENANT_API_SECRET, defaults to this value in docker-compose.yml).
# Publicly known defaults are rejected in production (APP_ENV=production): generate with
#   openssl rand -hex 32
API_SECRET_KEY=dev-api-key-replace-in-production

# Frontend (dev profile): tenant slug and secret used to sign requests to the backend.
# Only set these to override the defaults (TENANT_SLUG=default, secret = API_SECRET_KEY).
# TENANT_SLUG=default
# TENANT_API_SECRET=

# Multi-Tenant Mode (defaults to false)
# Set to true to enable per-tenant data isolation, tenant switcher, and tenant management.
# The database migration itself runs on every container start (both modes).
# MULTI_TENANT_ENABLED=false

# Platform Admin Credentials (required when MULTI_TENANT_ENABLED=true)
# The platform admin can manage all tenants and switch between them.
# Generate password hash: docker compose exec backend php scripts/generate-password-hash.php "yourpassword"
# IMPORTANT: wrap the hash in SINGLE quotes. Docker Compose expands "$..." in this file, so an unquoted
# hash is silently truncated and the login fails.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH='$2y$10$....................................................'

# ============================================================================
# Production Checklist
# ============================================================================
# Before deploying:
# [ ] Change all passwords above
# [ ] Generate PDF_TOKEN_SECRET: openssl rand -hex 32
# [ ] Generate API_SECRET_KEY:   openssl rand -hex 32 (known defaults are rejected in production)
# [ ] Set strong MYSQL_ROOT_PASSWORD
# [ ] Review backend/.env for additional backend-specific settings
# ============================================================================
