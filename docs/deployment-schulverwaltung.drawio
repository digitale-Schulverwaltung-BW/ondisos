<mxfile host="app.diagrams.net">
  <diagram id="overview" name="Übersicht"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="o_title" value="&lt;b&gt;Digitale Schulverwaltung BW – Übersicht&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Vereinfachte Fassung der Detail-Skizze (Tab „Detail“) · Entwurf&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="50" as="geometry"/></mxCell><mxCell id="o_inet" value="&lt;b&gt;Internet&lt;/b&gt;" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="170" height="30" as="geometry"/></mxCell><mxCell id="o_vis" value="Besucher&lt;br&gt;(Eltern, Schüler, Betriebe)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="170" height="60" as="geometry"/></mxCell><mxCell id="o_wal" value="Apple / Google Wallet&lt;br&gt;(Geräte der Schüler)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="170" height="60" as="geometry"/></mxCell><mxCell id="o_fw1" value="&lt;b&gt;Externe Firewall&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;horizontal=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="100" width="40" height="420" as="geometry"/></mxCell><mxCell id="o_dmz" value="&lt;b&gt;Server-DMZ&lt;/b&gt; (öffentlich)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;startSize=28;fontSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="100" width="300" height="420" as="geometry"/></mxCell><mxCell id="o_form" value="&lt;b&gt;Ondisos-Frontend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Anmeldeformulare (Standalone / WordPress)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="o_dmz"><mxGeometry x="20" y="50" width="260" height="60" as="geometry"/></mxCell><mxCell id="o_walet" value="&lt;b&gt;WalletStudentID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Digitale Schülerausweise&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="o_dmz"><mxGeometry x="20" y="140" width="260" height="70" as="geometry"/></mxCell><mxCell id="o_web" value="&lt;i&gt;Weitere Web-Tools&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SelfServices · Signage · E-komo-mai&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="o_dmz"><mxGeometry x="20" y="240" width="260" height="70" as="geometry"/></mxCell><mxCell id="o_mail" value="Mailversand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="o_dmz"><mxGeometry x="20" y="340" width="260" height="50" as="geometry"/></mxCell><mxCell id="o_fw3" value="&lt;b&gt;Firewall pädagogisches Netz&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="530" width="300" height="28" as="geometry"/></mxCell><mxCell id="o_paed" value="&lt;b&gt;Pädagogisches Netz&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5f0e8;strokeColor=#5aa88f;startSize=28;fontSize=13;" vertex="1" parent="1"><mxGeometry x="290" y="568" width="300" height="130" as="geometry"/></mxCell><mxCell id="o_cli" value="Endgeräte Schüler / Lehrkräfte&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;und Signage-Displays&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="o_paed"><mxGeometry x="20" y="45" width="260" height="60" as="geometry"/></mxCell><mxCell id="o_fw2" value="&lt;b&gt;Interne Firewall&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;horizontal=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="40" height="420" as="geometry"/></mxCell><mxCell id="o_int" value="&lt;b&gt;Intranet&lt;/b&gt; (Verwaltungsnetz)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#6c8ebf;startSize=28;fontSize=14;" vertex="1" parent="1"><mxGeometry x="690" y="100" width="420" height="420" as="geometry"/></mxCell><mxCell id="o_be" value="&lt;b&gt;Ondisos-Backend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Verwaltung, Datenbank, Virenscan, Uploads&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="o_int"><mxGeometry x="20" y="50" width="380" height="70" as="geometry"/></mxCell><mxCell id="o_vf" value="&lt;b&gt;VertretungsFlow&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Abwesenheiten &amp;amp; Genehmigung&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="o_int"><mxGeometry x="20" y="150" width="380" height="70" as="geometry"/></mxCell><mxCell id="o_int2" value="&lt;i&gt;Weitere interne Tools&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;asv-exporter · Zeugnis-Archiv · LDAP/AD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="o_int"><mxGeometry x="20" y="250" width="380" height="70" as="geometry"/></mxCell><mxCell id="o_adm" value="Verwaltung, Sekretariat, Schulleitung, Lehrkräfte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="o_int"><mxGeometry x="20" y="350" width="380" height="50" as="geometry"/></mxCell><mxCell id="o_ext" value="&lt;b&gt;Externe Dienste&lt;/b&gt; (ausgehend)" style="text;html=1;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1140" y="100" width="200" height="30" as="geometry"/></mxCell><mxCell id="o_untis" value="WebUntis&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Stundenplan / Vertretung&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1150" y="150" width="180" height="60" as="geometry"/></mxCell><mxCell id="o_osm" value="Nominatim (OSM)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Adress-Geocoding&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1150" y="250" width="180" height="60" as="geometry"/></mxCell><mxCell id="o_leg" value="&lt;b&gt;Legende&lt;/b&gt; Grün: Ondisos · Orange: VertretungsFlow, WalletStudentID · Gestrichelt: weitere Tools · Rot: Firewall" style="text;html=1;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="540" width="500" height="40" as="geometry"/></mxCell><mxCell id="o_e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="o_vis" target="o_form"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="o_e2" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="o_wal" target="o_walet"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="o_e3" value="signierte API" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="o_form" target="o_be"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="o_e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="o_adm" target="o_be"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="o_e5" value="WebUntis-API" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d79b00;strokeWidth=2;dashed=1;" edge="1" parent="1" source="o_vf" target="o_untis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="o_e6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="o_be" target="o_osm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="o_e7" value="HTTPS / WSS" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="o_cli" target="o_web"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="deploy" name="Detail">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Digitale Schulverwaltung BW – Deployment-Skizze&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Ondisos, VertretungsFlow, WalletStudentID und weitere Tools (gestrichelt) · Entwurf, NAT-Regeln folgen separat · Zuordnung der Tools zu den Zonen ist eine Annahme&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1200" height="50" as="geometry"/>
        </mxCell>

        <!-- Internet links -->
        <mxCell id="visitors" value="Besucher&lt;br&gt;(Eltern, Schüler, Betriebe)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Browser, HTTPS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="150" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="walletcloud" value="&lt;b&gt;Apple Wallet / Google Wallet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Geräte der Schüler · APNs / Wallet-API&lt;br&gt;Pass-Registrierung &amp;amp; Updates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="420" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="mailext" value="Externe Mail-Empfänger&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Benachrichtigungen (SMTP)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="565" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="inetlbl" value="&lt;b&gt;Internet&lt;/b&gt;" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="170" height="30" as="geometry"/>
        </mxCell>

        <!-- Externe Firewall -->
        <mxCell id="fw1" value="&lt;b&gt;Externe Firewall&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;NAT / Portfreigaben (extern → DMZ): 443&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;horizontal=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="220" y="110" width="50" height="680" as="geometry"/>
        </mxCell>

        <!-- DMZ -->
        <mxCell id="dmz" value="&lt;b&gt;Server-DMZ&lt;/b&gt; (öffentlich erreichbar)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;startSize=28;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="110" width="420" height="680" as="geometry"/>
        </mxCell>
        <mxCell id="rp" value="&lt;b&gt;Reverse Proxy / Webserver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Apache/Nginx · TLS-Terminierung (HTTPS 443)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="dmz">
          <mxGeometry x="30" y="45" width="360" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="fe" value="&lt;b&gt;Ondisos-Frontend&lt;/b&gt; (Standalone PHP)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;index.php · save.php · pdf/download.php (PDF-Proxy)&lt;br&gt;Tenant-Secret nur serverseitig (.env)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="dmz">
          <mxGeometry x="30" y="120" width="360" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="wp" value="&lt;b&gt;WordPress + Ondisos-Plugin&lt;/b&gt; (Alternative)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Shortcode [ondisos form=…] · admin-ajax.php&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="dmz">
          <mxGeometry x="30" y="210" width="360" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="wallet" value="&lt;b&gt;WalletStudentID&lt;/b&gt; (Node.js / TypeScript)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Digitale Schülerausweise, mandantenfähig&lt;br&gt;Pass-Webservice (muss für Apple/Google erreichbar sein)&lt;br&gt;Admin-Dashboard, Bulk-Import, automatische Updates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="dmz">
          <mxGeometry x="30" y="280" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ekomo" value="&lt;i&gt;E-komo-mai&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;QR-Orientierung, ohne DB-Backend (PHP/FastAPI)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="dmz">
          <mxGeometry x="30" y="385" width="360" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="mailrelay" value="&lt;b&gt;Mail (PHP mail() / MTA)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Benachrichtigung an notify_email&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="dmz">
          <mxGeometry x="30" y="450" width="360" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="selfserv" value="&lt;i&gt;SelfServices&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Schüler-Portal (PHP), LDAP-Login&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="dmz">
          <mxGeometry x="30" y="540" width="175" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="signage" value="&lt;i&gt;OpenBrowserSignage&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;React, PocketBase, WebSocket&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="dmz">
          <mxGeometry x="215" y="540" width="175" height="60" as="geometry"/>
        </mxCell>

        <!-- Firewall Päd-Netz -->
        <mxCell id="fw3" value="&lt;b&gt;Firewall / Router pädagogisches Netz&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(Zugriff nur auf freigegebene DMZ-Dienste)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="800" width="420" height="30" as="geometry"/>
        </mxCell>

        <!-- Pädagogisches Netz -->
        <mxCell id="paed" value="&lt;b&gt;Pädagogisches Netz&lt;/b&gt; (Unterricht, WLAN, Schüler-/Lehrer-Endgeräte)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5f0e8;strokeColor=#5aa88f;startSize=28;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="840" width="420" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="paedclients" value="Endgeräte Schüler / Lehrkräfte&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Laptops, Tablets, BYOD (Browser)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="paed">
          <mxGeometry x="30" y="50" width="175" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="paeddisp" value="Signage-Displays (Flure)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Browser im Kiosk-Modus&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="paed">
          <mxGeometry x="215" y="50" width="175" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="paednet" value="WLAN-Controller / Switches (VLAN pädagogisch)" style="text;html=1;align=center;fontSize=10;" vertex="1" parent="paed">
          <mxGeometry x="30" y="140" width="360" height="30" as="geometry"/>
        </mxCell>

        <!-- Interne Firewall -->
        <mxCell id="fw2" value="&lt;b&gt;Interne Firewall&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;DMZ → Intranet: nur Backend-API (HTTPS/9080), LDAP&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;horizontal=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="750" y="110" width="50" height="680" as="geometry"/>
        </mxCell>

        <!-- Intranet -->
        <mxCell id="intra" value="&lt;b&gt;Intranet&lt;/b&gt; (Verwaltungsnetz, nicht öffentlich)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#6c8ebf;startSize=28;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="830" y="110" width="720" height="680" as="geometry"/>
        </mxCell>
        <mxCell id="dockerhost" value="&lt;b&gt;Backend-Server Ondisos&lt;/b&gt; (Docker Compose)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;startSize=26;" vertex="1" parent="intra">
          <mxGeometry x="30" y="50" width="420" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="be" value="&lt;b&gt;ondisos-backend&lt;/b&gt; (Apache/PHP 8.2)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Port 9080 · Admin-Oberfläche + signierte API&lt;br&gt;submit.php · upload.php · form-config.php · pdf&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="dockerhost">
          <mxGeometry x="20" y="45" width="380" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;MySQL 8.0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;3306, nur Docker-Netz&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="dockerhost">
          <mxGeometry x="20" y="170" width="170" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="av" value="&lt;b&gt;ClamAV&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;3310, Virenscan der Uploads&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="dockerhost">
          <mxGeometry x="230" y="170" width="170" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="vol" value="Volumes: mysql-data · uploads/tenant-&amp;lt;id&amp;gt; · logs · cache (Backup!)" style="text;html=1;align=center;fontSize=10;" vertex="1" parent="dockerhost">
          <mxGeometry x="20" y="285" width="380" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="vf" value="&lt;b&gt;VertretungsFlow&lt;/b&gt; (Python / FastAPI + React)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Planbare Lehrerabwesenheiten, zweistufige Genehmigung&lt;br&gt;WebUntis-Integration (ausgehend), Benachrichtigungen&lt;br&gt;Zugriff: Lehrkräfte, Schulleitung (Schulnetz)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="intra">
          <mxGeometry x="30" y="410" width="420" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="admin" value="&lt;b&gt;Verwaltung / Sekretariat / Schulleitung / Lehrkräfte&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Browser im Schulnetz&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="intra">
          <mxGeometry x="490" y="50" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="bkp" value="&lt;b&gt;Backup-Ziel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;DB-Dump + Upload-Volumes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="intra">
          <mxGeometry x="490" y="160" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="asvexp" value="&lt;i&gt;asv-exporter&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Python, ASV BW → Schüler-/Klassendaten&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="intra">
